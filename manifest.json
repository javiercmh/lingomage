{
  "name": "LingoMage",
  "short_name": "LingoMage",
  "version": "1.2.1",
  "templateVersion": 3,
  "description": "Create AI-powered stories tailored to your interests, vocabulary, and reading level.",
  "main": "index.html",
  "files": [
    "icon.png",
    "index.html",
    "css/style.css",
    "js/app.js",
    "js/bridge.js",
    "manifest.json",
    "AGENTS.md",
    "PACKAGING.md",
    "dev_server.py",
    "data/stories.json",
    "data/settings.json",
    "data/learning-profiles.json"
  ],
  "app2Update": {
    "appId": "com.javiercmh.lingomage",
    "minimumHostVersionCode": 4,
    "github": {
      "owner": "javiercmh",
      "repository": "lingomage",
      "branch": "main"
    },
    "managedFiles": [
      "icon.png",
      "index.html",
      "css/style.css",
      "js/app.js",
      "js/bridge.js",
      "manifest.json",
      "data/learning-profiles.json",
      "AGENTS.md",
      "PACKAGING.md"
    ],
    "seedFiles": [
      "data/stories.json",
      "data/settings.json"
    ],
    "seedDefaults": {
      "data/stories.json": [],
      "data/settings.json": {}
    }
  },
  "icons": [
    {
      "src": "icon.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
